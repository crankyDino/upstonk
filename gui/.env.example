# Copy to gui/.env for local development. Vite reads VITE_* at build time.

# API base URL. Leave unset: dev uses http://localhost:8080/api/v1 and
# production builds use same-origin /api/v1.
# VITE_UPSTONK_API_URL=http://localhost:8080/api/v1

# Supabase sign-in (leave unset for an open local API). The publishable
# (anon) key is safe to ship to browsers.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
