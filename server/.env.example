# Copy to server/.env and fill in. server/.env is gitignored; this file is not.

# Bind address for the API
SERVER_ADDRESS=:8080

# Alpha Vantage key; "demo" leaves the provider disabled
ALPHA_VANTAGE_API_KEY=demo

# Postgres connection string (Supabase: session-mode pooler on port 5432)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Sign-in (Supabase Auth). When set, every API route except /api/v1/health
# needs a signed-in, admitted user. Requires DATABASE_URL.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Always admins (comma-separated)
ADMIN_EMAILS=you@example.com
